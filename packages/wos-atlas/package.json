{
  "name": "@pubfunc/wos-atlas",
  "version": "0.0.0",
  "description": "Typed fetch-based SDK for the Whiteout Survival Atlas API",
  "repository": {
    "type": "git",
    "url": "https://github.com/pubfunc/node-utils.git"
  },
  "author": "Pubfunc",
  "license": "MIT",
  "homepage": "https://github.com/pubfunc/node-utils",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-typescript https://wosatlas.com/developer-api/openapi.json -o src/schema.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
